          {
            "Id": 4340,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 1072,
            "Name": "SqlQuery",
            "Value": "SELECT TOP 1\r\n    rt.Id AS ExistingTaskId,\r\n    rt.FundingRequest,\r\n    rt.AssignedTo,\r\n    rt.TaskType,\r\n    rt.Status\r\nFROM app.ReviewTask rt\r\nWHERE rt.FundingRequest = @FundingRequestId\r\n  AND rt.TaskType = @TaskType\r\n  AND rt.Status IN ('Pending', 'In Progress')\r\nORDER BY rt.Id DESC;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
