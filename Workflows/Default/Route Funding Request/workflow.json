            "LastModifiedBy": null
          },
          {
            "Id": 4307,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 1065,
            "Name": "SqlQuery",
            "Value": "SELECT TOP 1\r\n    rr.Id AS RoutingRuleId,\r\n    rr.Name AS RoutingRuleName,\r\n    rr.AssignedTo,\r\n    rr.TaskType,\r\n    rr.Priority,\r\n    fr.Id AS FundingRequestId\r\nFROM app.FundingRequest fr\r\nINNER JOIN app.ReviewRoutingRule rr\r\n    ON rr.IsActive = 1\r\n    AND (rr.Organization IS NULL\r\n         OR rr.Organization = fr.Organization)\r\n    AND (rr.FundingCategory IS NULL\r\n         OR rr.FundingCategory = fr.FundingCategory)\r\n    AND (rr.MinimumAmount IS NULL\r\n         OR fr.RequestedAmount >= rr.MinimumAmount)\r\n    AND (rr.MaximumAmount IS NULL\r\n         OR fr.RequestedAmount <= rr.MaximumAmount)\r\nWHERE fr.Id = @FundingRequestId\r\nORDER BY rr.Priority ASC, rr.Id ASC;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
